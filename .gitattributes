# One line ending for everyone. Without this, Git for Windows checks files out with CRLF and
# generated files (AGENTS.md, the Copilot skill mirror) look 'out of date' on another computer.
* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# CAD files and images are binary: never diff or convert them.
*.f3d binary
*.f3z binary
*.stl binary
*.step binary
*.stp binary
*.3mf binary
*.iges binary
*.igs binary
*.sat binary
*.smt binary
*.obj binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
