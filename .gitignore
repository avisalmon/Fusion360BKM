# Virtual environment - ALWAYS named `env`. (`.env` below is a different thing.)
env/
.venv/
venv/

# Secrets / local config. Never commit .env.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# The bridge writes its live port (and ad-hoc screenshots) here: per-computer, regenerated at start.
bridge/

# CAD exports are build outputs: big binaries regenerated by `fusion.py export`.
# Share a finished part as a GitHub Release, never in git. Source of truth = design.py.
# One exception: each example keeps its Fusion archive (examples/NN_name/<name>.f3d), the way the
# DE10 BKMs keep the .qar project, so a reader can open the finished design without the bridge.
exports/
*.stl
*.step
*.stp
*.f3d
!examples/**/*.f3d
*.f3z
*.3mf
*.obj
*.iges
*.igs
*.sat
*.smt
*.gcode

# Your own designs stay on your computer unless you decide otherwise (copy to examples/ to share).
my_designs/*
!my_designs/README.md

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Logs / temp
*.log
*.tmp
